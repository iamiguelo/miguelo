{
  "name": "miguelo",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/bg"]
  },
  // generador de imágenes (Workers AI)
  "ai": { "binding": "AI" },
  // freno por IP: máximo 3 imágenes por minuto
  "ratelimits": [
    { "name": "LIMITE", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }
  ]
}
