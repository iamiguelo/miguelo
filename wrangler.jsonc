{
  "name": "miguelo",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/bg"]
  },
  // generador de imágenes (Workers AI)
  "ai": { "binding": "AI" },
  // freno por IP: máximo 3 imágenes por minuto
  "ratelimits": [
    { "name": "LIMITE", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }
  ],
  // contador global del tope diario (gasto 0 €) y última imagen
  "durable_objects": { "bindings": [ { "name": "CONTADOR", "class_name": "Contador" } ] },
  "migrations": [ { "tag": "v1", "new_sqlite_classes": ["Contador"] } ]
}
